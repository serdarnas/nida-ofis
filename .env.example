# Rapor mailleri (sabah özeti, gün sonu raporu, hata uyarısı) — yalnız sahibine gider.
# Gerçek değerleri .env dosyasına veya Coolify ortam değişkenlerine yaz. Bu dosyaya parola YAZMA.

# Alıcı (varsayılan zaten bu adres)
RAPOR_ALICI=serdarnas@gmail.com

# Gönderen SMTP hesabı. İki seçenek:
# A) nidazeytin.com webmail hesabı (ör. olive@nidazeytin.com): host/port hosting panelindeki "Mail ayarları"ndan
# B) Gmail: smtp.gmail.com, port 587, "Uygulama Şifresi" (2 adımlı doğrulama açık olmalı)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Zamanlama (sunucu saat dilimi Europe/Istanbul)
RAPOR_SABAH_SAAT=08:00
RAPOR_GUN_SONU_SAAT=18:30

# 1 yaparsan her biten görev için ayrıca mail gelir (varsayılan 0: yalnız hata ve günlük raporlar)
RAPOR_GOREV_MAILI=0
# Mailleri tamamen kapatmak için 0
RAPOR_MAIL_AKTIF=1

# Video uretici (video_uretici.py) icin Hugging Face token
HF_TOKEN=

